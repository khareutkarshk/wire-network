---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import EarlyAccess from '../components/site/EarlyAccess.astro';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	/** Share image, relative to the site root. 1200 x 630. */
	image?: string;
	imageAlt?: string;
	/** Extra JSON-LD objects for this page */
	schema?: Record<string, unknown>[];
}

const SITE_NAME = 'Wire Network';
const {
	title = 'Wire Network | The Financial Control Plane',
	description = 'Wire coordinates ownership and execution across blockchains through one Universal Transaction Layer. Assets never leave their native chains.',
	noindex = false,
	image = '/og.png',
	imageAlt = 'Wire Network. Assets stay home. Ownership moves.',
	schema = [],
} = Astro.props;

// One canonical form: trailing slash, matching the sitemap, the directory build and every internal link
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

const org = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_NAME,
	url: Astro.site?.href,
	logo: new URL('/icon-512.png', Astro.site).href,
	sameAs: ['https://github.com/Wire-Network', 'https://x.com/wire_blockchain', 'https://www.linkedin.com/company/wire-network-blockchain/'],
};
const jsonLd = [org, ...schema];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content="#05070A" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@wire_blockchain" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<Analytics />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : jsonLd)} />

		<link rel="preload" href="/fonts/switzer-500.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/switzer-400.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Hide reveal targets before first paint, only when motion will run -->
		<script is:inline>
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion-ok');
		</script>
	</head>
	<body>
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-(--z-sheet) focus:rounded-control focus:bg-fg-1 focus:px-4 focus:py-2 focus:text-ink-950">Skip to content</a>
		<Nav />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<EarlyAccess />
		<div class="grain" aria-hidden="true"></div>

		<script>
			import { initMotion } from '../lib/motion';
			initMotion();
		</script>
	</body>
</html>
