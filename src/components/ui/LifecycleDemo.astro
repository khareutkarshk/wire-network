---
import { Icon } from 'astro-icon/components';
import ChainLogo from './ChainLogo.astro';

// A working state machine, not a mock: steps one transaction through the Wire lifecycle.
// Timings shown are measured from the run itself.
const steps = [
	{ state: 'pending', name: 'Pending', body: 'Transaction initiated on Ethereum' },
	{ state: 'routing', name: 'Routing', body: 'Optimal execution path determined' },
	{ state: 'executing', name: 'Executing', body: 'Validated and processed by the UTL' },
	{ state: 'settled', name: 'Settled', body: 'Ownership reassigned on Solana' },
];
---

<div class="console panel-edge overflow-hidden rounded-panel border border-line bg-ink-900" data-lifecycle>
	<!-- Console header: what is running, and how to drive it -->
	<div class="flex flex-col gap-4 border-b border-line px-5 py-4 md:flex-row md:items-center md:justify-between md:px-6">
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
			<span class="font-mono text-mono-s text-fg-1">0x7a3f…c91e</span>
			<span class="flex items-center gap-2 text-sm text-fg-2">
				<ChainLogo icon="cryptocurrency:eth" name="Ethereum" class="size-4 text-fg-1" />
				Ethereum
				<Icon name="ph:arrow-right" class="size-3.5 text-fg-3" aria-hidden="true" />
				<ChainLogo icon="cryptocurrency:sol" name="Solana" class="size-4 text-fg-1" />
				Solana
			</span>
		</div>
		<div class="flex items-center gap-2">
			<div role="radiogroup" aria-label="Outcome to simulate" class="seg inline-flex rounded-control border border-line-strong bg-ink-950 p-0.5">
				<button type="button" role="radio" aria-checked="true" data-lc-outcome="settled">
					<span class="seg-dot bg-state-settled" aria-hidden="true"></span>Settles
				</button>
				<button type="button" role="radio" aria-checked="false" data-lc-outcome="recovering">
					<span class="seg-dot bg-state-recovering" aria-hidden="true"></span>Fails
				</button>
			</div>
			<button type="button" class="replay inline-flex size-9 items-center justify-center rounded-control border border-line-strong text-fg-2" data-lc-replay>
				<Icon name="ph:arrow-counter-clockwise" class="size-4" aria-hidden="true" />
				<span class="sr-only">Replay transaction</span>
			</button>
		</div>
	</div>

	<div class="grid md:grid-cols-12">
		<!-- Step rail -->
		<ol class="relative flex flex-col p-5 md:col-span-7 md:p-6" aria-label="Transaction lifecycle">
			{
				steps.map((s, i) => (
					<li class="lc-step relative grid grid-cols-[1.25rem_1fr_auto] gap-x-4" data-step={i} data-status="idle" data-state={s.state}>
						<div class="relative flex justify-center" aria-hidden="true">
							<span class="lc-marker relative z-10 mt-1.5 flex size-5 items-center justify-center rounded-[5px] border">
								<Icon name="ph:check-bold" class="lc-check size-3" />
							</span>
							{i < steps.length - 1 && (
								<span class="absolute top-7 bottom-0 left-1/2 w-px -translate-x-1/2 bg-line-strong">
									<span class="lc-rail-fill block h-full w-px origin-top bg-accent" />
								</span>
							)}
						</div>
						<div class:list={['lc-body rounded-control px-3 py-2', i < steps.length - 1 && 'mb-3']}>
							<p class="lc-name text-[0.9375rem] font-medium">{s.name}</p>
							<p class="lc-desc mt-0.5 text-sm">{s.body}</p>
						</div>
						<span class="lc-time mt-2.5 font-mono text-mono-xs tabular-nums text-fg-3" data-time />
					</li>
				))
			}
		</ol>

		<!-- Receipt -->
		<div class="flex flex-col border-t border-line bg-ink-950/70 md:col-span-5 md:border-t-0 md:border-l">
			<div class="flex items-center justify-between border-b border-line px-5 py-3">
				<span class="flex items-center gap-2 font-mono text-mono-xs text-fg-2">
					<Icon name="ph:file-code" class="size-4 text-fg-3" aria-hidden="true" />receipt.json
				</span>
				<span class="font-mono text-mono-xs text-fg-3">Machine-readable</span>
			</div>
			<pre class="flex-1 overflow-x-auto p-5 font-mono text-mono-s leading-[1.75]" aria-live="polite" aria-label="Transaction receipt"><code data-lc-receipt></code></pre>
		</div>
	</div>
</div>

<style>
	/* Segmented outcome control */
	.seg button {
		display: inline-flex;
		height: 2rem;
		align-items: center;
		gap: 0.5rem;
		padding: 0 0.75rem;
		border-radius: 4px;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--color-fg-2);
		transition: background-color var(--duration-ui), color var(--duration-ui);
	}
	.seg button:hover { color: var(--color-fg-1); }
	.seg button[aria-checked='true'] {
		background: var(--color-ink-800);
		color: var(--color-fg-1);
		box-shadow: inset 0 0 0 1px var(--color-line-strong);
	}
	.seg-dot { width: 6px; height: 6px; border-radius: 1px; opacity: 0.45; }
	.seg button[aria-checked='true'] .seg-dot { opacity: 1; }
	.replay { transition: color var(--duration-ui), border-color var(--duration-ui), transform var(--duration-ui); }
	.replay:hover { color: var(--color-fg-1); border-color: var(--color-fg-3); }
	.replay:active { transform: rotate(-30deg) scale(0.96); }
	.console [disabled] { opacity: 0.45; pointer-events: none; }

	/* Steps: idle -> active -> done; the final step takes the outcome color */
	.lc-step { --c: var(--color-fg-3); }
	.lc-step[data-status='active'],
	.lc-step[data-status='done'] { --c: var(--color-accent-soft); }
	.lc-step[data-status='active'][data-state='settled'],
	.lc-step[data-status='done'][data-state='settled'] { --c: var(--color-state-settled); }
	.lc-step[data-status='active'][data-state='recovering'],
	.lc-step[data-status='done'][data-state='recovering'] { --c: var(--color-state-recovering); }

	.lc-marker {
		border-color: color-mix(in oklab, var(--c) 60%, transparent);
		background: var(--color-ink-900);
		color: var(--color-ink-950);
		transition: background-color var(--duration-ui), border-color var(--duration-ui);
	}
	.lc-check { opacity: 0; transition: opacity var(--duration-ui); }
	.lc-step[data-status='done'] .lc-marker { background: var(--c); border-color: var(--c); }
	.lc-step[data-status='done'] .lc-check { opacity: 1; }
	.lc-step[data-status='active'] .lc-marker {
		border-color: var(--c);
		box-shadow: 0 0 0 4px color-mix(in oklab, var(--c) 18%, transparent);
	}
	.lc-step[data-status='active'] .lc-marker::after {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 1px;
		background: var(--c);
	}
	.lc-step[data-status='active'] .lc-check { display: none; }

	.lc-body { transition: background-color var(--duration-reveal) var(--ease-out-expo); }
	.lc-step[data-status='active'] .lc-body { background: color-mix(in oklab, var(--c) 7%, transparent); }
	.lc-name { color: var(--color-fg-3); transition: color var(--duration-ui); }
	.lc-desc { color: var(--color-fg-3); transition: color var(--duration-ui); }
	.lc-step:not([data-status='idle']) .lc-name { color: var(--color-fg-1); }
	.lc-step:not([data-status='idle']) .lc-desc { color: var(--color-fg-2); }
	.lc-step[data-status='active'] .lc-name { color: var(--c); }
	/* The outcome is the answer: it keeps its color and tint once reached */
	.lc-step:last-child[data-status='done'] .lc-name { color: var(--c); }
	.lc-step:last-child[data-status='done'] .lc-body { background: color-mix(in oklab, var(--c) 8%, transparent); }

	.lc-rail-fill { transform: scaleY(0); }

	/* Receipt syntax: keys quiet, values readable, state carries its color */
	.console :global(.rk) { color: var(--color-fg-3); }
	.console :global(.rv) { color: var(--color-fg-1); }
	.console :global(.rp) { color: var(--color-fg-3); }
	.console :global(.rs-settled) { color: var(--color-state-settled); }
	.console :global(.rs-recovering) { color: var(--color-state-recovering); }
	.console :global(.rs-flight) { color: var(--color-accent-soft); }
	.console :global(.rl) { display: block; margin: 0 -0.5rem; padding: 0 0.5rem; border-radius: 3px; }
	@media (prefers-reduced-motion: no-preference) {
		.console :global(.rl.is-new) { animation: line-in 1.2s var(--ease-out-expo); }
	}
	@keyframes line-in {
		from { background: rgb(47 107 255 / 0.18); }
		to { background: transparent; }
	}
</style>

<script>
	import { gsap, prefersReducedMotion } from '../../lib/motion';
	import { scramble } from '../../lib/scramble';

	type Outcome = 'settled' | 'recovering';
	const FINAL: Record<Outcome, { name: string; body: string; extra: Record<string, string> }> = {
		settled: { name: 'Settled', body: 'Ownership reassigned on Solana', extra: { validation: 'passed', ownership: 'reassigned' } },
		recovering: { name: 'Recovering', body: 'Target timed out. Defined recovery path started.', extra: { validation: 'passed', reason: 'target_timeout', recovery: 'defined_path', ownership: 'unchanged' } },
	};
	const STEP_EXTRA: Record<number, Record<string, string>> = { 1: { route: 'wire-utl' } };
	const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);

	document.querySelectorAll<HTMLElement>('[data-lifecycle]').forEach((root) => {
		const reduce = prefersReducedMotion();
		const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
		const receipt = root.querySelector<HTMLElement>('[data-lc-receipt]')!;
		const radios = [...root.querySelectorAll<HTMLButtonElement>('[data-lc-outcome]')];
		const replay = root.querySelector<HTMLButtonElement>('[data-lc-replay]')!;
		const last = steps[steps.length - 1];
		let outcome: Outcome = 'settled';
		let timers: number[] = [];
		let prevKeys = new Set<string>();

		const render = (data: Record<string, string>) => {
			const entries = Object.entries(data);
			receipt.innerHTML =
				'<span class="rl"><span class="rp">{</span></span>' +
				entries
					.map(([k, v], i) => {
						const cls = k === 'state' ? (v === 'settled' ? 'rs-settled' : v === 'recovering' ? 'rs-recovering' : 'rs-flight') : 'rv';
						const isNew = prevKeys.size > 0 && !prevKeys.has(k);
						return `<span class="rl${isNew || k === 'state' ? ' is-new' : ''}">  <span class="rk">"${esc(k)}"</span><span class="rp">: </span><span class="${cls}">"${esc(v)}"</span><span class="rp">${i < entries.length - 1 ? ',' : ''}</span></span>`;
					})
					.join('') +
				'<span class="rl"><span class="rp">}</span></span>';
			prevKeys = new Set(entries.map(([k]) => k));
		};

		const show = (index: number, start: number) => {
			steps.forEach((s, i) => {
				s.dataset.status = i < index ? 'done' : i === index ? 'active' : 'idle';
				const fill = s.querySelector<HTMLElement>('.lc-rail-fill');
				if (fill) gsap.to(fill, { scaleY: i < index ? 1 : 0, duration: reduce ? 0 : 0.5, ease: 'expo.out' });
			});
			steps[index].querySelector<HTMLElement>('[data-time]')!.textContent = `+${((performance.now() - start) / 1000).toFixed(2)}s`;
			const isLast = index === steps.length - 1;
			if (isLast) {
				steps[index].dataset.status = 'done';
				scramble(last.querySelector<HTMLElement>('.lc-name')!, FINAL[outcome].name, reduce);
			}
			let data: Record<string, string> = { tx: '0x7a3f…c91e', origin: 'ethereum', target: 'solana' };
			for (let i = 1; i <= index; i++) data = { ...data, ...(STEP_EXTRA[i] ?? {}) };
			data.state = isLast ? outcome : steps[index].dataset.state!;
			if (isLast) data = { ...data, ...FINAL[outcome].extra };
			render(data);
		};

		const setBusy = (busy: boolean) => [...radios, replay].forEach((b) => (b.disabled = busy));

		const run = () => {
			timers.forEach(clearTimeout);
			timers = [];
			prevKeys = new Set();
			last.dataset.state = outcome;
			last.querySelector('.lc-name')!.textContent = FINAL[outcome].name;
			last.querySelector('.lc-desc')!.textContent = FINAL[outcome].body;
			steps.forEach((s) => (s.querySelector<HTMLElement>('[data-time]')!.textContent = ''));
			setBusy(true);
			const start = performance.now();
			steps.forEach((_, i) =>
				timers.push(
					window.setTimeout(() => {
						show(i, start);
						if (i === steps.length - 1) setBusy(false);
					}, reduce ? 0 : 150 + i * 850),
				),
			);
		};

		radios.forEach((r) =>
			r.addEventListener('click', () => {
				outcome = r.dataset.lcOutcome as Outcome;
				radios.forEach((x) => x.setAttribute('aria-checked', String(x === r)));
				run();
			}),
		);
		replay.addEventListener('click', run);

		// Resting state before it scrolls into view: just initiated
		render({ tx: '0x7a3f…c91e', origin: 'ethereum', target: 'solana', state: 'pending' });
		steps[0].dataset.status = 'active';
		new IntersectionObserver(
			([e], obs) => {
				if (!e.isIntersecting) return;
				run();
				obs.disconnect();
			},
			{ threshold: 0.45 },
		).observe(root);
	});
</script>
