---
// Transaction lifecycle state. The only place state colors are allowed.
// The indicator is semantic (real state), not decoration.
export type LifecycleState = 'pending' | 'routing' | 'executing' | 'settled' | 'recovering';

interface Props {
	state: LifecycleState;
	class?: string;
	[key: string]: unknown;
}
const { state, class: className, ...rest } = Astro.props;
---

<span
	class:list={['lifecycle-chip inline-flex h-7 items-center gap-2 rounded-control border px-2.5 font-mono text-mono-xs font-medium uppercase tracking-[0.1em]', className]}
	data-state={state}
	{...rest}
>
	<span class="lifecycle-indicator" aria-hidden="true"></span>
	<span class="lifecycle-label">{state}</span>
</span>

<style>
	.lifecycle-chip {
		--c: var(--color-fg-2);
		color: var(--c);
		border-color: color-mix(in oklab, var(--c) 28%, transparent);
		background: color-mix(in oklab, var(--c) 7%, transparent);
		transition:
			color var(--duration-ui) var(--ease-out-expo),
			border-color var(--duration-ui) var(--ease-out-expo),
			background-color var(--duration-ui) var(--ease-out-expo);
	}
	.lifecycle-chip[data-state='routing'] { --c: var(--color-accent-soft); }
	.lifecycle-chip[data-state='executing'] { --c: var(--color-accent-soft); }
	.lifecycle-chip[data-state='settled'] { --c: var(--color-state-settled); }
	.lifecycle-chip[data-state='recovering'] { --c: var(--color-state-recovering); }

	.lifecycle-indicator {
		position: relative;
		width: 6px;
		height: 6px;
		border-radius: 1px;
		background: var(--c);
	}
	/* In-flight states get a progress tick; terminal states are solid */
	.lifecycle-chip[data-state='pending'] .lifecycle-indicator {
		background: transparent;
		box-shadow: inset 0 0 0 1px var(--c);
	}
	@media (prefers-reduced-motion: no-preference) {
		.lifecycle-chip[data-state='routing'] .lifecycle-indicator,
		.lifecycle-chip[data-state='executing'] .lifecycle-indicator {
			animation: tick 1.1s steps(2, jump-none) infinite;
		}
	}
	@keyframes tick {
		from { opacity: 1; }
		to { opacity: 0.25; }
	}
</style>
