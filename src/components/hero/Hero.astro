---
import { Icon } from 'astro-icon/components';
import Convergence from './Convergence';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import LifecycleChip from '../ui/LifecycleChip.astro';
import ChainLogo from '../ui/ChainLogo.astro';
import { EARLY_ACCESS_HREF } from '../../lib/site';
---

<section class="hero relative isolate flex min-h-[100dvh] flex-col justify-center overflow-hidden pt-24 pb-16 md:min-h-[min(100dvh,1000px)]" aria-labelledby="hero-title">
	<!-- Convergence field: bleeds off the right edge, fades into ink under the copy -->
	<div class="hero-field absolute inset-y-0 right-0 -z-10 w-full md:w-[70%]" aria-hidden="true">
		<Convergence client:visible />
	</div>

	<Container class="relative">
		<h1 id="hero-title" class="text-[clamp(2.125rem,0.9rem+6.4vw,7rem)] sm:text-[clamp(3rem,1.2rem+6.4vw,7rem)] leading-[0.98] tracking-[-0.045em] font-medium" data-hero-title>
			<span class="block text-fg-1">Assets stay home.</span>
			<span class="block text-fg-3">Ownership moves.</span>
		</h1>
		<p class="mt-8 max-w-[31rem] text-body-l text-fg-2" data-hero-in>
			Wire tracks ownership across Ethereum, Solana and 300+ chains. People, apps and AI agents get one answer: settled or recovered.
		</p>
		<div class="mt-10 flex flex-wrap items-center gap-3" data-hero-in>
			<Button href={EARLY_ACCESS_HREF} class="max-sm:w-full">Get Early Access</Button>
			<Button href="/#about" variant="secondary" class="max-sm:w-full">Explore the Network</Button>
		</div>

		<!-- Live receipt: a real lifecycle, not a mock dashboard. Desktop only. -->
		<div class="hero-receipt-wrap absolute right-6 bottom-0 hidden w-[21.5rem] lg:block" data-hero-in>
			<!-- Previous receipt peeking behind: the network keeps settling -->
			<div class="receipt receipt-back absolute inset-x-4 -top-8 h-24 rounded-panel px-5 pt-3" aria-hidden="true">
				<div class="flex items-center justify-between font-mono text-mono-xs text-fg-3">
					<span class="flex items-center gap-2">
						<ChainLogo icon="cryptocurrency:sol" name="Solana" class="size-3.5" />
						Solana
						<Icon name="ph:arrow-right" class="size-3" />
						<ChainLogo icon="cryptocurrency:ada" name="Cardano" class="size-3.5" />
						Cardano
					</span>
					<span class="uppercase tracking-widest text-state-settled/70">Settled</span>
				</div>
			</div>

			<figure class="receipt relative rounded-panel p-5" data-receipt>
				<figcaption class="sr-only">Example transfer: the asset stays on Ethereum while ownership moves to Solana through the Wire lifecycle</figcaption>

				<div class="flex items-center justify-between">
					<span class="font-mono text-mono-xs uppercase tracking-[0.14em] text-fg-3">Transfer</span>
					<LifecycleChip state="settled" data-receipt-chip />
				</div>

				<p class="mt-5 flex items-baseline gap-2">
					<span class="text-[1.875rem] leading-none font-medium tracking-[-0.03em] text-fg-1 tabular-nums">1,250.00</span>
					<span class="font-mono text-mono-s text-fg-3">USDC</span>
				</p>

				<!-- Route: origin, track with moving packet, destination -->
				<div class="mt-5 flex items-center gap-3">
					<div class="flex flex-col items-center gap-1.5">
						<span class="chain-tile"><ChainLogo icon="cryptocurrency:eth" name="Ethereum" class="size-[1.125rem]" /></span>
					</div>
					<div class="relative h-px flex-1 bg-line-strong">
						<div class="absolute inset-y-0 left-0 w-full origin-left bg-linear-to-r from-accent/40 to-accent" style="transform: scaleX(1)" data-receipt-fill></div>
						<span class="packet absolute top-1/2 left-full" data-receipt-packet aria-hidden="true"></span>
					</div>
					<div class="flex flex-col items-center gap-1.5">
						<span class="chain-tile"><ChainLogo icon="cryptocurrency:sol" name="Solana" class="size-[1.125rem]" /></span>
					</div>
				</div>
				<div class="mt-2 flex justify-between text-[0.8125rem]">
					<span class="text-fg-1">Ethereum</span>
					<span class="text-fg-1">Solana</span>
				</div>

				<dl class="mt-5 flex flex-col gap-2.5 border-t border-line pt-4 text-[0.8125rem]">
					<div class="flex items-center justify-between gap-4">
						<dt class="flex items-center gap-2 text-fg-3"><Icon name="ph:lock-simple" class="size-3.5" aria-hidden="true" />Asset</dt>
						<dd class="text-fg-2">Stays on Ethereum</dd>
					</div>
					<div class="flex items-center justify-between gap-4">
						<dt class="flex items-center gap-2 text-fg-3"><Icon name="ph:arrow-bend-up-right" class="size-3.5" aria-hidden="true" />Ownership</dt>
						<dd class="text-fg-1 transition-colors duration-(--duration-ui)" data-receipt-owner>Moved to Solana</dd>
					</div>
				</dl>
			</figure>
		</div>
	</Container>
</section>

<style>
	/* Poster: holds the field's tone before WebGL paints (no CLS, no flash) */
	.hero-field {
		background:
			repeating-linear-gradient(122deg, rgb(47 107 255 / 0.10) 0 2px, transparent 2px 46px),
			var(--color-ink-950);
		mask-image: linear-gradient(to right, transparent 0%, #000 46%), linear-gradient(to bottom, transparent 0%, #000 16%, #000 76%, transparent 100%);
		mask-composite: intersect;
		-webkit-mask-composite: source-in;
	}
	@media (max-width: 767px) {
		.hero-field {
			opacity: 0.45;
			mask-image: linear-gradient(to top, transparent 0%, #000 50%);
		}
	}
	/* Receipt material: dark glass with a lit top edge and a shadow tinted to ink, no glow */
	.receipt {
		background: linear-gradient(180deg, rgb(20 27 36 / 0.78), rgb(8 11 16 / 0.86));
		border: 1px solid rgb(232 237 244 / 0.11);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.06),
			0 30px 60px -20px rgb(2 4 6 / 0.85),
			0 12px 24px -12px rgb(2 4 6 / 0.6);
		backdrop-filter: blur(18px) saturate(140%);
		-webkit-backdrop-filter: blur(18px) saturate(140%);
	}
	.receipt::before {
		content: '';
		position: absolute;
		inset: -1px 18% auto;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgb(126 165 255 / 0.55), transparent);
		pointer-events: none;
	}
	.receipt-back {
		background: rgb(11 16 22 / 0.7);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04);
	}
	.receipt-back::before { display: none; }
	.chain-tile {
		display: inline-flex;
		width: 2.25rem;
		height: 2.25rem;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-control);
		border: 1px solid var(--color-line-strong);
		background: var(--color-ink-800);
		color: var(--color-fg-1);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05);
	}
	/* The packet: the transaction itself, travelling the route */
	.packet {
		width: 7px;
		height: 7px;
		border-radius: 2px;
		background: var(--color-fg-1);
		transform: translate(-50%, -50%) rotate(45deg);
		box-shadow: 0 0 0 3px rgb(47 107 255 / 0.25);
	}
	@media (prefers-reduced-transparency: reduce) {
		.receipt { background: var(--color-ink-900); backdrop-filter: none; }
	}
	html.motion-ok .hero [data-hero-in] { opacity: 0; }
	html.motion-ok .hero [data-hero-title] { visibility: hidden; }
</style>

<script>
	import { gsap, prefersReducedMotion, EASE, DUR } from '../../lib/motion';
	import { scramble } from '../../lib/scramble';
	import { SplitText } from 'gsap/SplitText';

	const reduce = prefersReducedMotion();

	if (!reduce) {
		document.fonts.ready.then(() => {
			const title = document.querySelector<HTMLElement>('.hero [data-hero-title]');
			if (!title) return;
			const tl = gsap.timeline({ defaults: { ease: EASE } });
			SplitText.create(title.querySelectorAll('span'), {
				type: 'lines',
				mask: 'lines',
				// Line wrappers only; words stay intact and readable. (aria-label is not allowed on a plain span.)
				aria: 'none',
				autoSplit: true,
				onSplit(self) {
					gsap.set(title, { visibility: 'visible' });
					return tl.from(self.lines, { yPercent: 110, duration: DUR.hero, stagger: 0.12 }, 0.1);
				},
			});
			tl.fromTo('.hero [data-hero-in]', { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: DUR.hero, stagger: 0.09 }, 0.45);
		});
	}

	// Receipt cycles one transaction through the lifecycle. Pauses offscreen; static (settled) under reduced motion.
	const receipt = document.querySelector<HTMLElement>('[data-receipt]');
	if (receipt && !reduce) {
		const chip = receipt.querySelector<HTMLElement>('[data-receipt-chip]')!;
		const label = chip.querySelector<HTMLElement>('.lifecycle-label')!;
		const fill = receipt.querySelector<HTMLElement>('[data-receipt-fill]')!;
		const packet = receipt.querySelector<HTMLElement>('[data-receipt-packet]')!;
		const owner = receipt.querySelector<HTMLElement>('[data-receipt-owner]')!;
		const steps = [
			{ state: 'pending', progress: 0, owner: 'With sender' },
			{ state: 'routing', progress: 0.34, owner: 'With sender' },
			{ state: 'executing', progress: 0.7, owner: 'Updating' },
			{ state: 'settled', progress: 1, owner: 'Moved to Solana' },
		];
		const holds = [1000, 1100, 1300, 3400];
		let i = 0;
		let timer = 0;
		const tick = () => {
			const s = steps[i];
			chip.dataset.state = s.state;
			scramble(label, s.state);
			owner.textContent = s.owner;
			owner.classList.toggle('text-fg-1', s.state === 'settled');
			owner.classList.toggle('text-fg-3', s.state !== 'settled');
			// Restarting: snap back to origin instead of sweeping backwards
			const dur = s.progress === 0 ? 0 : 0.9;
			gsap.to(fill, { scaleX: s.progress, duration: dur, ease: EASE });
			gsap.to(packet, { left: `${s.progress * 100}%`, duration: dur, ease: EASE });
			timer = window.setTimeout(tick, holds[i]);
			i = (i + 1) % steps.length;
		};
		new IntersectionObserver(([e]) => {
			clearTimeout(timer);
			if (e.isIntersecting) tick();
		}).observe(receipt);
	}
</script>
