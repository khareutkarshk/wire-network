---
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import WireMark from './WireMark.astro';
import { NAV, EARLY_ACCESS_HREF } from '../../lib/site';

// Compare without trailing slashes so /developers and /developers/ both mark the item
const norm = (p: string) => p.replace(/\/$/, '') || '/';
const path = norm(Astro.url.pathname);
---

<div id="nav-sentinel" class="pointer-events-none absolute inset-x-0 top-0 h-2" aria-hidden="true"></div>
<header id="site-nav" class="fixed inset-x-0 top-0 z-(--z-nav) transition-[background-color,border-color] duration-(--duration-reveal) ease-out-expo" data-scrolled="false">
	<nav aria-label="Primary" class="mx-auto flex h-16 w-full max-w-page items-center gap-8 px-4 md:px-6">
		<a href="/" class="flex items-center gap-2.5 text-fg-1" aria-label="Wire Network home">
			<WireMark class="h-[15px] w-auto" />
			<span class="whitespace-nowrap text-[0.9375rem] font-semibold tracking-[-0.01em]">Wire Network</span>
		</a>

		<ul class="ml-auto hidden items-center gap-1 md:flex">
			{
				NAV.map((item) => (
					<li>
						<a
							href={item.href}
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noopener noreferrer' : undefined}
							aria-current={!item.external && norm(item.href) === path ? 'page' : undefined}
							class="nav-link inline-flex h-9 items-center gap-1 rounded-control px-3 text-sm text-fg-2 transition-colors duration-(--duration-ui) hover:text-fg-1 aria-[current=page]:text-fg-1"
						>
							{item.label}
							{item.external && (
								<>
									<Icon name="ph:arrow-up-right" class="size-3.5 text-fg-3" aria-hidden="true" />
									<span class="sr-only">(opens in a new tab)</span>
								</>
							)}
						</a>
					</li>
				))
			}
		</ul>

		<div class="hidden md:block"><Button href={EARLY_ACCESS_HREF} size="sm">Get Early Access</Button></div>

		<button
			type="button"
			class="ml-auto inline-flex size-10 items-center justify-center rounded-control text-fg-1 md:hidden"
			aria-controls="nav-sheet"
			aria-expanded="false"
			data-nav-toggle
		>
			<span class="sr-only">Open menu</span>
			<Icon name="ph:list" class="size-5" data-icon-open aria-hidden="true" />
			<Icon name="ph:x" class="hidden size-5" data-icon-close aria-hidden="true" />
		</button>
	</nav>

	<div id="nav-sheet" class="hidden border-t border-line bg-ink-950 md:hidden" data-nav-sheet>
		<ul class="flex flex-col px-4 py-3">
			{
				NAV.map((item) => (
					<li>
						<a
							href={item.href}
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noopener noreferrer' : undefined}
							class="flex h-12 items-center justify-between text-body-l text-fg-1"
						>
							{item.label}
							<Icon name={item.external ? 'ph:arrow-up-right' : 'ph:arrow-right'} class="size-4 text-fg-3" aria-hidden="true" />
						</a>
					</li>
				))
			}
		</ul>
		<div class="px-4 pb-5">
			<Button href={EARLY_ACCESS_HREF} class="w-full">Get Early Access</Button>
		</div>
	</div>
</header>

<style>
	#site-nav {
		border-bottom: 1px solid transparent;
	}
	#site-nav[data-scrolled='true'] {
		background: rgb(5 7 10 / 0.78);
		border-bottom-color: var(--color-line);
		backdrop-filter: blur(14px) saturate(140%);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
	}
	@media (prefers-reduced-transparency: reduce) {
		#site-nav[data-scrolled='true'] {
			background: var(--color-ink-950);
			backdrop-filter: none;
		}
	}
</style>

<script>
	const nav = document.getElementById('site-nav')!;
	const sentinel = document.getElementById('nav-sentinel')!;
	// Scrolled state from an observer, never a scroll listener
	new IntersectionObserver(([entry]) => {
		nav.dataset.scrolled = String(!entry.isIntersecting);
	}).observe(sentinel);

	const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
	const sheet = nav.querySelector<HTMLElement>('[data-nav-sheet]')!;
	const setOpen = (open: boolean) => {
		toggle.setAttribute('aria-expanded', String(open));
		toggle.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
		toggle.querySelector('[data-icon-open]')!.classList.toggle('hidden', open);
		toggle.querySelector('[data-icon-close]')!.classList.toggle('hidden', !open);
		sheet.classList.toggle('hidden', !open);
		if (open) nav.dataset.scrolled = 'true';
	};
	toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
	sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
	document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
