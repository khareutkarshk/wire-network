---
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { EARLY_ACCESS_HREF } from '../../lib/site';

const outcomes = [
	{ who: 'For people', what: 'Reliable financial execution across ecosystems.' },
	{ who: 'For applications', what: 'A shared execution and ownership layer.' },
	{ who: 'For AI agents', what: 'Deterministic, machine-readable financial state.' },
];
---

<Section id="vision" labelledby="vision-title">
	<h2 id="vision-title" class="max-w-[22ch] text-h2 font-medium text-fg-1" data-split>A multi-chain world needs a shared financial state</h2>

	<ul class="mt-14 border-t border-line-strong">
		{outcomes.map((o, i) => (
			<li class="grid gap-2 border-b border-line py-7 md:grid-cols-12 md:items-baseline md:gap-10 md:py-9" data-reveal data-reveal-delay={i * 0.06}>
				<p class="font-mono text-mono-s text-fg-3 md:col-span-3">{o.who}</p>
				<p class="text-[clamp(1.5rem,1rem+1.8vw,2.5rem)] leading-[1.15] tracking-[-0.025em] text-fg-1 md:col-span-9">{o.what}</p>
			</li>
		))}
	</ul>

</Section>

<style>
	.cta {
		background:
			radial-gradient(70% 120% at 100% 100%, rgb(47 107 255 / 0.16), transparent 65%),
			repeating-linear-gradient(122deg, rgb(47 107 255 / 0.05) 0 1px, transparent 1px 34px),
			var(--color-ink-900);
	}
</style>

<script>
	import { gsap, prefersReducedMotion } from '../../lib/motion';

	// Roadmap line draws from testnet toward mainnet: where we are now (state)
	const fill = document.querySelector('[data-roadmap] .roadmap-fill');
	if (fill && !prefersReducedMotion()) {
		gsap.from(fill, { scaleY: 0, duration: 1.2, ease: 'expo.out', scrollTrigger: { trigger: fill, start: 'top 85%', once: true } });
	}
</script>
