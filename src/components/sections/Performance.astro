---
import { Icon } from 'astro-icon/components';
import Section from '../ui/Section.astro';

const specs = [
	{ icon: 'ph:gas-pump', value: 'Gas-optional', label: 'Execution' },
	{ icon: 'ph:receipt', value: 'Structured', label: 'Transaction receipts' },
	{ icon: 'ph:arrow-u-up-left', value: 'Defined', label: 'Recovery paths' },
	{ icon: 'ph:brackets-curly', value: 'Machine-readable', label: 'Financial state' },
	{ icon: 'ph:lightning', value: 'High-frequency', label: 'Multi-chain workflows' },
];
---

<Section id="performance" labelledby="performance-title" class="border-t border-line">
	<div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
		<div class="lg:col-span-6">
			<h2 id="performance-title" class="text-h2 font-medium text-fg-1" data-split>Built for <span class="whitespace-nowrap">machine-scale</span> commerce</h2>
			<div class="mt-12 lg:mt-20">
				<p class="text-[clamp(5rem,2rem+11vw,11rem)] leading-[0.85] font-medium tracking-[-0.055em] text-fg-1 tabular-nums">
					<span data-count="10000">10,000</span><span class="text-accent">+</span>
				</p>
				<p class="mt-5 font-mono text-mono-s text-fg-2">Transactions per second</p>
			</div>
		</div>

		<div class="lg:col-span-6 lg:pt-3">
			<ul class="grid gap-px overflow-hidden rounded-panel border border-line bg-line sm:grid-cols-2">
				{specs.map((s, i) => (
					<li class:list={['flex items-center gap-4 bg-ink-950 px-5 py-4 sm:flex-col sm:items-start sm:justify-between sm:gap-10 sm:p-6', i === 0 && 'sm:col-span-2']} data-reveal data-reveal-delay={i * 0.05}>
						<Icon name={s.icon} class="size-5 shrink-0 text-fg-3" aria-hidden="true" />
						<div>
							<p class="text-lg font-medium text-fg-1 sm:text-h3">{s.value}</p>
							<p class="text-sm text-fg-2 sm:mt-1 sm:text-base">{s.label}</p>
						</div>
					</li>
				))}
			</ul>
			<p class="mt-4 text-sm text-fg-3">Network specifications and targets as stated by Wire Network, not independent benchmarks.</p>
		</div>
	</div>
</Section>

<script>
	import { gsap, prefersReducedMotion } from '../../lib/motion';

	// Count-up draws the eye to the one number that matters (hierarchy)
	if (!prefersReducedMotion()) {
		document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
			const target = Number(el.dataset.count);
			const obj = { v: 0 };
			gsap.to(obj, {
				v: target,
				duration: 1.6,
				ease: 'expo.out',
				scrollTrigger: { trigger: el, start: 'top 85%', once: true },
				onUpdate: () => (el.textContent = Math.round(obj.v).toLocaleString('en-US')),
			});
		});
	}
</script>
