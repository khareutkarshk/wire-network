---
import { Icon } from 'astro-icon/components';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';

const requirements = [
	{ icon: 'ph:check-square-offset', label: 'Deterministic transaction state' },
	{ icon: 'ph:brackets-curly', label: 'Machine-readable outcomes' },
	{ icon: 'ph:magnifying-glass', label: 'Queryable execution lifecycle' },
	{ icon: 'ph:sliders-horizontal', label: 'Policy-driven workflows' },
	{ icon: 'ph:lightning', label: 'High-frequency transactions' },
	{ icon: 'ph:arrows-split', label: 'Multi-chain execution' },
	{ icon: 'ph:clipboard-text', label: 'Auditable financial state' },
];
const questions = [
	'Which chain holds the asset?',
	'Is the token wrapped?',
	'Which bridge is being used?',
	'What happens if execution fails?',
	'Where does ownership currently sit?',
];
---

<Section id="agents" labelledby="agents-title" tone="raised">
	<div class="max-w-[46rem]">
		<Eyebrow>The autonomous AI economy</Eyebrow>
		<h2 id="agents-title" class="mt-5 text-h2 font-medium text-fg-1" data-split>Software is starting to move money. It needs certainty.</h2>
	</div>

	<div class="mt-12" data-tabs>
		<div role="tablist" aria-label="Who Wire is built for" class="inline-flex rounded-control border border-line-strong bg-ink-950 p-1">
			<button role="tab" id="tab-agents" aria-controls="panel-agents" aria-selected="true" class="tab">For agents</button>
			<button role="tab" id="tab-people" aria-controls="panel-people" aria-selected="false" tabindex="-1" class="tab">For people</button>
		</div>

		<!-- Agents -->
		<div role="tabpanel" id="panel-agents" aria-labelledby="tab-agents" class="mt-10 grid gap-12 lg:grid-cols-12">
			<blockquote class="lg:col-span-5">
				<p class="text-[clamp(1.5rem,1.1rem+1.4vw,2.25rem)] leading-[1.2] tracking-[-0.025em] text-fg-1">
					Agents should act on confirmed financial state, not probabilistic outcomes.
				</p>
				<p class="mt-5 max-w-[42ch] text-fg-2">
					Autonomous agents need machine-readable state, predictable execution and clearly defined outcomes. Wire is built around those requirements.
				</p>
			</blockquote>
			<ul class="grid gap-px overflow-hidden rounded-panel border border-line bg-line sm:grid-cols-2 lg:col-span-7">
				{requirements.map((r, i) => (
					<li class:list={['flex items-center gap-4 bg-ink-900 p-5', i === requirements.length - 1 && 'sm:col-span-2']}>
						<Icon name={r.icon} class="size-5 shrink-0 text-accent-soft" aria-hidden="true" />
						<span class="text-fg-1">{r.label}</span>
					</li>
				))}
			</ul>
		</div>

		<!-- People -->
		<div role="tabpanel" id="panel-people" aria-labelledby="tab-people" class="mt-10 grid gap-12 lg:grid-cols-12" hidden>
			<div class="lg:col-span-5">
				<p class="text-[clamp(1.5rem,1.1rem+1.4vw,2.25rem)] leading-[1.2] tracking-[-0.025em] text-fg-1">Multi-chain, without the chain anxiety.</p>
				<p class="mt-5 max-w-[42ch] text-fg-2">
					People shouldn't need to understand every chain behind a transaction. Wire makes many ecosystems behave like one financial environment.
				</p>
			</div>
			<ul class="flex flex-col lg:col-span-7" data-questions>
				{questions.map((q) => (
					<li class="flex items-center justify-between gap-6 border-b border-line py-4 last:border-b-0">
						<span class="question text-lg text-fg-1">{q}</span>
						<span class="shrink-0 font-mono text-mono-xs uppercase tracking-widest text-fg-3">Handled</span>
					</li>
				))}
			</ul>
		</div>
	</div>
</Section>

<style>
	.tab {
		height: 2.25rem;
		padding: 0 1rem;
		border-radius: 4px;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-fg-2);
		transition: background-color var(--duration-ui), color var(--duration-ui);
	}
	.tab:hover {
		color: var(--color-fg-1);
	}
	.tab[aria-selected='true'] {
		background: var(--color-fg-1);
		color: var(--color-ink-950);
	}
	/* The question gets answered: a line strikes through it */
	.question {
		background: linear-gradient(var(--color-fg-3), var(--color-fg-3)) 0 55% / var(--strike, 0%) 1px no-repeat;
		transition: color var(--duration-reveal) var(--ease-out-expo);
	}
	[data-questions].is-struck .question {
		--strike: 100%;
		color: var(--color-fg-3);
	}
</style>

<script>
	import { gsap, prefersReducedMotion } from '../../lib/motion';

	document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const reduce = prefersReducedMotion();

		const strike = (panel: HTMLElement) => {
			const list = panel.querySelector<HTMLElement>('[data-questions]');
			if (!list) return;
			list.classList.remove('is-struck');
			const qs = list.querySelectorAll<HTMLElement>('.question');
			if (reduce) {
				list.classList.add('is-struck');
				return;
			}
			gsap.fromTo(qs, { '--strike': '0%' }, { '--strike': '100%', duration: 0.5, stagger: 0.12, ease: 'expo.out', delay: 0.35, onComplete: () => list.classList.add('is-struck') });
		};

		const select = (tab: HTMLButtonElement) => {
			tabs.forEach((t) => {
				const on = t === tab;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
				panel.hidden = !on;
				if (on) {
					if (!reduce) gsap.fromTo(panel, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.45, ease: 'expo.out' });
					strike(panel);
				}
			});
		};

		tabs.forEach((t, i) => {
			t.addEventListener('click', () => select(t));
			t.addEventListener('keydown', (e) => {
				if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
				const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
				next.focus();
				select(next);
			});
		});
	});
</script>
