---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import ChainLogo from '../ui/ChainLogo.astro';
import { CHAINS } from '../../lib/site';

const apps = ['DEXs', 'Wallets', 'DeFi protocols', 'AI agents', 'Financial apps'];
const functions = ['Routing', 'Validation', 'Settlement', 'Risk control'];
const steps = [
	{ title: 'Applications connect once', body: 'DEXs, wallets, protocols and agents.' },
	{ title: 'Wire coordinates', body: 'Routing, validation, settlement, risk control.' },
	{ title: 'Chains stay sovereign', body: '300+ networks. Assets never leave home.' },
];

// Connector geometry (viewBox 1000 x 100): fan in from 5 apps, fan out to 8 chain slots.
const fanIn = [100, 300, 500, 700, 900].map((x, i) => {
	const tx = 380 + i * 60;
	return `M${x} 0 C${x} 55, ${tx} 45, ${tx} 100`;
});
const fanOut = Array.from({ length: 8 }, (_, i) => {
	const x = 62.5 + i * 125;
	const sx = 360 + i * 40;
	return `M${sx} 0 C${sx} 55, ${x} 45, ${x} 100`;
});
---

<section id="utl" class="utl relative" aria-labelledby="utl-title">
	<div class="utl-pin flex min-h-[100dvh] items-center py-20 lg:py-0">
		<Container>
			<div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
				<!-- Story -->
				<div class="lg:col-span-4 lg:self-center">
					<Eyebrow>Universal Transaction Layer</Eyebrow>
					<h2 id="utl-title" class="mt-5 text-h2 font-medium text-fg-1">One layer between applications and chains</h2>
					<ol class="utl-steps mt-12 flex flex-col" data-steps>
						{
							steps.map((s, i) => (
								<li class="utl-step relative py-3.5 pl-6" data-step={i} data-active="true">
									<p class="step-title text-[1.0625rem] font-medium">{s.title}</p>
									<p class="step-body mt-1 text-[0.9375rem]">{s.body}</p>
								</li>
							))
						}
					</ol>
				</div>

				<!-- Diagram -->
				<figure class="lg:col-span-8 lg:self-center" aria-label="Applications connect to the Wire UTL, which coordinates execution across blockchains">
					<ul class="flex flex-wrap justify-center gap-2 sm:grid sm:grid-cols-5" data-layer="apps">
						{apps.map((a) => <li class="flex h-11 items-center justify-center rounded-control border border-line-strong bg-ink-900 px-4 text-center text-sm text-fg-1 sm:h-12 sm:px-2">{a}</li>)}
					</ul>

					<svg class="utl-lines hidden h-20 w-full sm:block" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
						{fanIn.map((d) => <path d={d} class="utl-base" />)}
						{fanIn.map((d) => <path d={d} pathLength="1" class="utl-live" data-line="in" />)}
					</svg>
					<div class="mx-auto h-8 w-px bg-line-strong sm:hidden" aria-hidden="true"></div>

					<div class="utl-core panel-edge relative overflow-hidden rounded-panel border border-accent/40 p-5 md:p-6" data-layer="core">
						<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
							<div>
								<p class="text-h3 font-medium text-fg-1">Wire UTL</p>
								<p class="mt-1 font-mono text-mono-s text-fg-3">Built on Wire L1, UPAP and WNS</p>
							</div>
							<ul class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
								{functions.map((f) => <li class="rounded-control border border-line-strong bg-ink-950/60 px-3 py-2 text-center font-mono text-mono-s text-fg-1" data-fn>{f}</li>)}
							</ul>
						</div>
					</div>

					<svg class="utl-lines hidden h-20 w-full sm:block" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
						{fanOut.map((d) => <path d={d} class="utl-base" />)}
						{fanOut.map((d) => <path d={d} pathLength="1" class="utl-live" data-line="out" />)}
					</svg>
					<div class="mx-auto h-8 w-px bg-line-strong sm:hidden" aria-hidden="true"></div>

					<ul class="grid grid-cols-4 gap-2 sm:grid-cols-8" data-layer="chains">
						{
							CHAINS.map((c) => (
								<li class="flex aspect-square flex-col items-center justify-center gap-2 rounded-control border border-line bg-ink-900 text-fg-1">
									<ChainLogo icon={c.icon} name={c.name} class="size-6" />
									<span class="text-[0.6875rem] text-fg-3">{c.name}</span>
								</li>
							))
						}
						<li class="flex aspect-square flex-col items-center justify-center rounded-control border border-dashed border-line-strong text-center">
							<span class="text-lg font-medium text-fg-1">300+</span>
							<span class="text-[0.6875rem] text-fg-3">networks</span>
						</li>
					</ul>
				</figure>
			</div>
		</Container>
	</div>
</section>

<style>
	/* Story rail: one continuous line, the active step's segment lights up */
	.utl-step::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 2px;
		background: var(--color-line-strong);
		transition: background-color var(--duration-reveal) var(--ease-out-expo);
	}
	.step-title { color: var(--color-fg-1); transition: color var(--duration-reveal) var(--ease-out-expo); }
	.step-body { color: var(--color-fg-2); transition: color var(--duration-reveal) var(--ease-out-expo); }
	.utl-step[data-active='true']::before { background: var(--color-accent); }
	.utl-step[data-active='false'] .step-title { color: var(--color-fg-3); }
	.utl-step[data-active='false'] .step-body { color: var(--color-fg-3); }
	.utl-step[data-active='false']::before { background: var(--color-line-strong); }

	.utl-core {
		background:
			radial-gradient(80% 140% at 50% 0%, rgb(47 107 255 / 0.18), transparent 70%),
			var(--color-ink-900);
	}
	.utl-base,
	.utl-live {
		fill: none;
		vector-effect: non-scaling-stroke;
		stroke-width: 1px;
	}
	.utl-base {
		stroke: var(--color-line-strong);
	}
	.utl-live {
		stroke: var(--color-accent);
		stroke-width: 1.5px;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}
</style>

<script>
	import { gsap, prefersReducedMotion } from '../../lib/motion';

	const root = document.querySelector<HTMLElement>('.utl');
	if (root && !prefersReducedMotion()) {
		const mm = gsap.matchMedia();

		// Desktop: pin and scrub the assembly (storytelling)
		mm.add('(min-width: 1024px)', () => {
			const q = gsap.utils.selector(root);
			const steps = q('[data-step]');
			const setActive = (n: number) => steps.forEach((el, i) => ((el as HTMLElement).dataset.active = String(i === n)));
			setActive(0);
			const tl = gsap.timeline({
				defaults: { ease: 'none' },
				scrollTrigger: {
					trigger: root,
					start: 'top top',
					end: '+=180%',
					pin: '.utl-pin',
					scrub: 0.6,
					// Story follows the diagram: apps, then the UTL, then chains
					onUpdate: (self) => setActive(self.progress < 0.34 ? 0 : self.progress < 0.66 ? 1 : 2),
				},
			});
			gsap.set(q('[data-line]'), { strokeDashoffset: 1 });

			tl.from(q('[data-layer="apps"] li'), { opacity: 0.15, y: -10, stagger: 0.05, duration: 0.4 })
				.to(q('[data-line="in"]'), { strokeDashoffset: 0, stagger: 0.04, duration: 0.5 })
				.from(q('[data-layer="core"]'), { opacity: 0.2, scale: 0.97, duration: 0.4 }, '<0.3')
				.from(q('[data-fn]'), { opacity: 0, y: 6, stagger: 0.06, duration: 0.3 }, '<0.1')
				.to(q('[data-line="out"]'), { strokeDashoffset: 0, stagger: 0.03, duration: 0.5 })
				.from(q('[data-layer="chains"] li'), { opacity: 0.15, y: 10, stagger: 0.04, duration: 0.4 }, '<0.3')
				.to({}, { duration: 0.3 });

			// Leaving desktop: every step readable again
			return () => steps.forEach((el) => ((el as HTMLElement).dataset.active = 'true'));
		});

		// Mobile: simple reveal, no pin
		mm.add('(max-width: 1023px)', () => {
			gsap.from(root.querySelectorAll('[data-layer]'), {
				opacity: 0,
				y: 16,
				stagger: 0.12,
				duration: 0.6,
				ease: 'expo.out',
				scrollTrigger: { trigger: root, start: 'top 75%', once: true },
			});
		});
	}
</script>
