---
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero.astro';
import NetworkBar from '../components/sections/NetworkBar.astro';
import Problem from '../components/sections/Problem.astro';
import Utl from '../components/sections/Utl.astro';
import Lifecycle from '../components/sections/Lifecycle.astro';
import Ownership from '../components/sections/Ownership.astro';
import Agents from '../components/sections/Agents.astro';
import Primitives from '../components/sections/Primitives.astro';
import Performance from '../components/sections/Performance.astro';
import DevTeaser from '../components/sections/DevTeaser.astro';
import Closing from '../components/sections/Closing.astro';
// Section blueprint and rationale: docs/site-plan.md
---

<Base
	schema={[
		{
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: 'Wire Network',
			url: 'https://wire.network/',
			description: 'Wire coordinates ownership and execution across blockchains through one Universal Transaction Layer.',
		},
	]}
>
	<Hero />
	<NetworkBar />
	<Problem />
	<Utl />
	<Lifecycle />
	<Ownership />
	<Agents />
	<Primitives />
	<Performance />
	<DevTeaser />
	<Closing />
</Base>
