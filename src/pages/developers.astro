---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
import TextLink from '../components/ui/TextLink.astro';
import Panel from '../components/ui/Panel.astro';
import { STACK } from '../lib/stack';
import { EARLY_ACCESS_HREF, GITHUB_HREF, WHITEPAPER_HREF } from '../lib/site';

const groups = [
	{
		title: 'Write',
		icon: 'ph:code',
		items: ['Smart contracts in C++', 'Compiled to WebAssembly', 'Contract Development Toolkit (CDT)'],
		surface: 'tint',
	},
	{
		title: 'Integrate',
		icon: 'ph:plugs-connected',
		items: ['Node APIs', 'SDKs, starting with sdk-core', 'Multi-chain transaction infrastructure'],
		surface: 'plain',
	},
	{
		title: 'Operate',
		icon: 'ph:terminal-window',
		items: ['CLI tooling with clio', 'Key management with kiod', 'Wire Hub explorer'],
		surface: 'grid',
	},
] as const;

// Descriptions from the repos at github.com/Wire-Network
const resources = [
	{ name: 'wire-sysio', body: 'Core software for developing and deploying blockchain-based applications.', href: 'https://github.com/Wire-Network/wire-sysio' },
	{ name: 'wire-cdt', body: 'Contract Development Toolkit for WebAssembly smart contracts.', href: 'https://github.com/Wire-Network/wire-cdt' },
	{ name: 'sdk-core', body: 'Core functionality for interacting with Wire blockchains.', href: 'https://github.com/Wire-Network/sdk-core' },
	{ name: 'guides', body: 'Template repositories for step-by-step Wire tutorials.', href: 'https://github.com/Wire-Network/guides' },
	{ name: 'wire-docs', body: 'Official Wire documentation.', href: 'https://github.com/Wire-Network/wire-docs' },
	{ name: 'Whitepaper', body: 'The protocol, the UTL and the design rationale in full.', href: WHITEPAPER_HREF },
];
---

<Base title="Developers | Wire Network" description="Build applications that coordinate assets, ownership and execution across chains. Node software, contract toolkit, SDKs and CLI.">
	<!-- Hero -->
	<section class="relative overflow-hidden pt-36 pb-20 md:pt-44 md:pb-24" aria-labelledby="dev-hero-title">
		<div class="dev-hero-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
		<Container>
			<div class="grid gap-14 lg:grid-cols-12 lg:items-end">
				<div class="lg:col-span-7">
					<Eyebrow>Developers</Eyebrow>
					<h1 id="dev-hero-title" class="mt-6 text-[clamp(2.75rem,1.4rem+4.6vw,5.25rem)] leading-[1] tracking-[-0.04em] font-medium text-fg-1" data-split>
						Build once. Reach multiple ecosystems.
					</h1>
					<p class="mt-7 max-w-[34rem] text-body-l text-fg-2" data-reveal>
						Wire Sysio is the node software and toolchain behind the network, built on Spring, the AntelopeIO implementation.
					</p>
					<div class="mt-10 flex flex-wrap gap-3" data-reveal data-reveal-delay="0.08">
						<Button href="https://github.com/Wire-Network/wire-sysio" variant="secondary" external>View wire-sysio</Button>
						<Button href={EARLY_ACCESS_HREF}>Get Early Access</Button>
					</div>
				</div>
				<figure class="lg:col-span-5" data-reveal data-reveal-delay="0.16">
					<figcaption class="mb-3 font-mono text-mono-xs uppercase tracking-[0.12em] text-fg-3">Verify your install</figcaption>
					<pre class="overflow-x-auto rounded-panel border border-line bg-ink-900 p-5 font-mono text-mono-s leading-relaxed"><code><span class="text-fg-3">$</span> <span class="text-fg-1">nodeop --full-version</span>
<span class="text-fg-2">v3.1.2-0b64f879e3ebe2e4df09d2e62f1fc164cc1125d1</span></code></pre>
					<p class="mt-3 text-sm text-fg-3">Example output from the wire-sysio README. Build from source for Ubuntu 24.04+ or macOS Apple Silicon.</p>
				</figure>
			</div>
		</Container>
	</section>

	<!-- Stack -->
	<Section id="stack" class="border-t border-line" labelledby="stack-title">
		<Heading id="stack-title" split>The developer stack</Heading>
		<ol class="mt-12 border-t border-line-strong">
			{STACK.map((s) => (
				<li class="grid gap-3 border-b border-line py-7 md:grid-cols-12 md:gap-10 md:py-9" data-reveal>
					<p class="font-mono text-h3 text-fg-1 md:col-span-3">{s.name}</p>
					<div class="md:col-span-6">
						<p class="text-lg font-medium text-fg-1">{s.role}</p>
						<p class="mt-1.5 max-w-[52ch] text-fg-2">{s.detail}</p>
					</div>
					<div class="md:col-span-3 md:text-right">
						{s.repo ? <TextLink href={s.repo} external>{s.repo.split('/').pop()}</TextLink> : <span class="text-sm text-fg-3">Public link coming</span>}
					</div>
				</li>
			))}
		</ol>
	</Section>

	<!-- Capabilities -->
	<Section class="border-t border-line" tone="raised" labelledby="cap-title">
		<Heading id="cap-title" split>Write, integrate, operate</Heading>
		<div class="mt-12 grid gap-4 md:grid-cols-3">
			{groups.map((g, i) => (
				<Panel surface={g.surface} class:list={['flex flex-col p-7', i === 1 && 'md:translate-y-8']} data-reveal data-reveal-delay={i * 0.06}>
					<Icon name={g.icon} class="size-6 text-accent-soft" aria-hidden="true" />
					<h3 class="mt-10 text-h3 font-medium text-fg-1">{g.title}</h3>
					<ul class="mt-5 flex flex-col gap-3">
						{g.items.map((it) => (
							<li class="flex gap-3 text-fg-2">
								<Icon name="ph:check" class="mt-1 size-4 shrink-0 text-fg-3" aria-hidden="true" />
								{it}
							</li>
						))}
					</ul>
				</Panel>
			))}
		</div>
	</Section>

	<!-- Resources -->
	<Section class="border-t border-line" labelledby="res-title">
		<div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
			<Heading id="res-title" split>Start from source</Heading>
			<TextLink href={GITHUB_HREF} external>All repositories</TextLink>
		</div>
		<ul class="mt-12 grid gap-px overflow-hidden rounded-panel border border-line bg-line md:grid-cols-2 lg:grid-cols-3">
			{resources.map((r) => (
				<li>
					<a href={r.href} target="_blank" rel="noopener noreferrer" class="group flex h-full flex-col justify-between gap-10 bg-ink-950 p-6 transition-colors duration-(--duration-ui) hover:bg-ink-900">
						<div class="flex items-start justify-between gap-4">
							<span class="font-mono text-body-l text-fg-1">{r.name}</span>
							<Icon name="ph:arrow-up-right" class="size-4 text-fg-3 transition-transform duration-(--duration-ui) ease-out-expo group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-fg-1" aria-hidden="true" />
						</div>
						<p class="text-fg-2">{r.body}</p>
						<span class="sr-only">(opens in a new tab)</span>
					</a>
				</li>
			))}
		</ul>
	</Section>

	<!-- CTA -->
	<Section class="border-t border-line" labelledby="dev-cta-title">
		<div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
			<div>
				<h2 id="dev-cta-title" class="text-h2 font-medium text-fg-1">Mainnet launches October 2026</h2>
				<p class="mt-4 max-w-[46ch] text-fg-2">Get developer access ahead of launch and build against the V2 testnet today.</p>
			</div>
			<Button href={EARLY_ACCESS_HREF}>Get Early Access</Button>
		</div>
	</Section>
</Base>

<style>
	.dev-hero-bg {
		background:
			radial-gradient(60% 70% at 85% 10%, rgb(47 107 255 / 0.12), transparent 70%),
			linear-gradient(var(--color-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
		background-size: auto, 56px 56px, 56px 56px;
		mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
	}
</style>
